{
	"name": "take-shelter-now",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest --project=unit",
		"test:unit:coverage": "vitest run --coverage --project=unit --coverage.reportsDirectory=coverage/unit",
		"test:storybook:coverage": "vitest run --coverage --project=storybook --coverage.reportsDirectory=coverage/storybook",
		"test:storybook": "vitest --project=storybook",
		"test": "npm run test:unit -- --run && npm run test:storybook -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"shadcn": "shadcn-svelte"
	},
	"dependencies": {
		"@ethercorps/sveltekit-og": "^4.3.0",
		"@internationalized/date": "^3.12.4",
		"@maplibre/maplibre-gl-leaflet": "^0.1.4",
		"@stadiamaps/api": "^9.1.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"csv-parse": "^7.0.2",
		"leaflet": "^1.9.4",
		"maplibre-gl": "^6.10.0",
		"sitemap": "^9.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.47.0",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.2",
		"@types/vt-pbf": "^3.1.1",
		"@vitest/browser": "^5.0.1",
		"@vitest/browser-playwright": "^5.0.1",
		"@vitest/coverage-v8": "^5.0.1",
		"chromatic": "^18.9.4",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.0",
		"mode-watcher": "^1.1.0",
		"msw": "2.15.0",
		"msw-storybook-addon": "^3.0.3",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"schema-dts": "^2.0.0",
		"shadcn-svelte": "^1.7.0",
		"storybook": "^10.2.14",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "8.3.0",
		"vitest": "^5.0.1",
		"vt-pbf": "^3.1.3"
	},
	"msw": {
		"workerDirectory": [
			".storybook/public"
		]
	},
	"allowScripts": {
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.1": true,
		"msw@2.15.0": true
	}
}
